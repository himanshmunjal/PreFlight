# Copy to .env (git-ignored). docker compose passes it to the preflight container.
# Telegram: create a bot with @BotFather, message it once, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email backup (used when Telegram is unset or fails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Absolute URL of docs/runbooks.md in your repo, so runbook links in alerts are clickable.
# Example: https://github.com/<you>/preflight/blob/main/docs/runbooks.md
RUNBOOK_URL=
